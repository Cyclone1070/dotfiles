{
  "name": "dsh-notification",
  "version": "0.2.1",
  "private": true,
  "description": "Browser task notifications for DeepSeek Harness — tells you when the agent needs you or has actually finished a turn, and never fires while delegated background work is still running.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/predicate.test.mjs"
  }
}
