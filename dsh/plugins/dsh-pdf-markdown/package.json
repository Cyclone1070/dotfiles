{
  "name": "dsh-pdf-markdown",
  "version": "0.1.0",
  "description": "PDF to Markdown for DeepSeek Harness: one tool that turns a PDF into a Markdown file with its figures extracted as linked PNG assets, placed where they belong in the reading order.",
  "author": {
    "name": "Cyclone1070",
    "url": "https://github.com/Cyclone1070"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyclone1070/dotfiles.git",
    "directory": "dsh/plugins/dsh-pdf-markdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "markdown",
    "marker",
    "ocr",
    "document-conversion"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
